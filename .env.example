APP_NAME="Sadayana"
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# URL form login admin (ganti di production)
ADMIN_LOGIN_PATH=login

# Akun admin awal saat APP_ENV=production (db:seed). Password kosong = dibuat
# acak dan ditampilkan sekali di terminal. Non-production memakai akun demo.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Bahasa default landing page: id | en
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Masa berlaku token API Sanctum dalam menit (default 7 hari)
SANCTUM_EXPIRATION=10080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Target produksi: PostgreSQL. Test memakai SQLite :memory: (phpunit.xml)
# dan PostgreSQL `sadayana_testing` (phpunit.pgsql.xml / composer test:pgsql).
# MySQL tidak didukung (partial unique index). Untuk coba cepat tanpa
# PostgreSQL: DB_CONNECTION=sqlite dan hapus baris DB_* lain.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sadayana
DB_USERNAME=postgres
DB_PASSWORD=

# Komunitas default (mode satu perumahan per instalasi)
COMMUNITY_CODE=default
COMMUNITY_NAME="Perumahan Sadayana"
COMMUNITY_TIMEZONE=Asia/Jakarta

# Upload privat (foto meter, bukti transfer), ukuran maksimum dalam KB
UPLOADS_MAX_IMAGE_KB=5120
UPLOADS_MAX_DOCUMENT_KB=5120

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): SESSION_SECURE_COOKIE=true dan SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# reCAPTCHA v3 (login + form kontak) — kosongkan key untuk mematikan captcha.
# Buat key di https://www.google.com/recaptcha/admin (pilih v3).
NOCAPTCHA_ENABLED=true
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

# Gambar hero landing (path relatif ke public/), kosong = gradasi
LANDING_HERO_IMAGE=
